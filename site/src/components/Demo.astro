---
import { initial, renderDetail, renderList, renderHint, STEPS } from "../scripts/demo-model";
const s = initial();
const KEYS = "n new  s settings  t board  ctrl+k palette  ? help";
---
<figure class="demo" aria-label="A live example of cairn: press the keys to walk ticket ENG-412 from plan to shipped">
  <figcaption class="hint" data-hint>
    <span class="hint-in" data-hint-in set:html={renderHint(s)} />
  </figcaption>
  <div class="stage">
    <div class="window" data-demo>
      <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>cairn — herdr</span></div>
      <div class="screen">
        <div class="row head"><span><span class="t-acc t-b">cairn</span>  <span class="t-mut">eng · web</span></span><span><span class="t-good live">●</span> <span class="t-mut">herdr</span>  <span class="t-good live" style="--d:-1.1s">●</span> <span class="t-mut">Linear</span>  <span class="t-good live" style="--d:-2.2s">●</span> <span class="t-mut">GitHub</span></span></div>
        <div class="panes">
          <div class="pane list" data-list set:html={renderList(s)} />
          <div class="pane detail" data-detail aria-live="polite" set:html={renderDetail(s)} />
        </div>
        <div class="foot"><span class="keys" data-foot aria-live="polite">{KEYS}</span><span class="t-dim">example data</span></div>
      </div>
    </div>
  </div>
  <ol class="rail" data-rail aria-label="Where the ticket is: click a step to jump to it" style="--p:0">
    {STEPS.map((st, i) => (
      <li><button type="button" data-step={st.id} aria-current={i === 0 ? "step" : undefined}><i aria-hidden="true"></i>{st.label}</button></li>
    ))}
  </ol>
</figure>

<script>
  import { initial, stateAt, renderDetail, renderList, renderHint, NOTES, STEPS, CI_TOTAL, type DemoState, type Step } from "../scripts/demo-model";

  const fig = document.querySelector<HTMLElement>(".demo")!;
  const root = fig.querySelector<HTMLElement>("[data-demo]")!;
  const detail = root.querySelector<HTMLElement>("[data-detail]")!;
  const list = root.querySelector<HTMLElement>("[data-list]")!;
  const foot = root.querySelector<HTMLElement>("[data-foot]")!;
  const rail = fig.querySelector<HTMLElement>("[data-rail]")!;
  const hintEl = fig.querySelector<HTMLElement>("[data-hint-in]")!;
  const KEYS = foot.textContent || "";
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const EASE = "cubic-bezier(0.23, 1, 0.32, 1)";

  let s: DemoState = initial();
  let timers: number[] = [];
  const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, reduce ? 0 : ms));
  const stop = () => { timers.forEach(clearTimeout); timers = []; };

  // What each line said last frame, so only the lines that changed light up.
  const snapshot = () => {
    const m = new Map<string, string>();
    root.querySelectorAll<HTMLElement>("[data-id]").forEach((el) => m.set(el.dataset.id!, el.textContent || ""));
    return m;
  };

  function paint() {
    const before = snapshot();
    const card = detail.querySelector<HTMLElement>("[data-card]")?.dataset.card;
    const step = rail.querySelector<HTMLElement>("[aria-current]")?.dataset.step;

    detail.innerHTML = renderDetail(s);
    list.innerHTML = renderList(s);
    hintEl.innerHTML = renderHint(s);

    const i = STEPS.findIndex((x) => x.id === s.step);
    rail.style.setProperty("--p", String(i / (STEPS.length - 1)));
    rail.querySelectorAll<HTMLElement>("[data-step]").forEach((b, j) => {
      b.toggleAttribute("aria-current", j === i);
      if (j === i) b.setAttribute("aria-current", "step");
      b.classList.toggle("done", j < i || s.step === "shipped");
    });

    if (reduce) return;
    // A changed line catches a brief light; the card settles in when its state changes.
    root.querySelectorAll<HTMLElement>("[data-id]").forEach((el) => {
      const was = before.get(el.dataset.id!);
      if (was === el.textContent) return;
      // A new line slides in; a line that only changed its value just glows.
      el.animate(
        was === undefined
          ? [{ backgroundColor: "rgba(189, 147, 249, 0.2)", transform: "translateX(-6px)", filter: "blur(2px)", opacity: 0.4 }, { backgroundColor: "rgba(189, 147, 249, 0)", transform: "none", filter: "blur(0)", opacity: 1 }]
          : [{ backgroundColor: "rgba(189, 147, 249, 0.22)" }, { backgroundColor: "rgba(189, 147, 249, 0)" }],
        { duration: was === undefined ? 520 : 700, easing: EASE },
      );
    });
    const nc = detail.querySelector<HTMLElement>("[data-card]");
    if (nc && nc.dataset.card !== card) {
      nc.animate(
        [{ filter: "blur(3px)", opacity: 0.4, transform: "translateY(5px) scale(0.99)" }, { filter: "blur(0)", opacity: 1, transform: "none" }],
        { duration: 320, easing: EASE },
      );
    }
    if (step && step !== s.step) {
      hintEl.animate([{ opacity: 0, filter: "blur(4px)", transform: "translateY(4px)" }, { opacity: 1, filter: "blur(0)", transform: "none" }], { duration: 360, easing: EASE });
    }
  }

  function runBuild() {
    const seq: Array<() => void> = [
      () => ((s.tasks = ["x", "~", " ", " "]), (s.proofs = 1)),
      () => ((s.tasks = ["x", "x", "~", " "]), (s.sides = [true, false])),
      () => ((s.tasks = ["x", "x", "x", "~"]), (s.proofs = 2), (s.other = 5)),
      () => ((s.tasks = ["x", "x", "x", "x"]), (s.sides = [true, true]), (s.proofs = 3)),
      () => (s.step = "push"),
    ];
    seq.forEach((f, i) => later(800 * (i + 1), () => { f(); paint(); }));
  }

  function runReview() {
    for (let c = s.ci + 1; c <= CI_TOTAL; c++) later(420 * c, () => { s.ci = c; paint(); });
    later(420 * CI_TOTAL + 700, () => { s.review = "ok"; paint(); });
    later(420 * CI_TOTAL + 2600, () => { s.merged = true; s.step = "shipped"; s.other = 6; paint(); });
  }

  function jump(step: Step) {
    stop();
    s = stateAt(step);
    if (step === "review") s.ci = 0;
    paint();
    if (step === "build") runBuild();
    if (step === "review") runReview();
  }

  let noteTimer = 0;
  function note(text: string) {
    foot.textContent = text;
    foot.classList.add("note");
    if (!reduce) foot.animate([{ opacity: 0, transform: "translateY(4px)" }, { opacity: 1, transform: "none" }], { duration: 240, easing: EASE });
    clearTimeout(noteTimer);
    noteTimer = window.setTimeout(() => { foot.textContent = KEYS; foot.classList.remove("note"); }, 3200);
  }

  function press(key: string) {
    if (key === "v" && s.step === "plan") { s.answered = true; jump("build"); return; }
    if (key === "a" && s.step === "push") { jump("review"); return; }
    if (key === "r" && s.step === "shipped") { jump("plan"); return; }
    if (key === "e" && s.step === "plan" && !s.answered) { s.answered = true; paint(); return; }
    if (NOTES[key]) note(NOTES[key]);
  }

  // Nobody touching it? It walks itself through, one decision at a time,
  // and hands over the moment you press anything.
  let touched = false;
  let visible = false;
  let idle = 0;
  const auto = () => {
    clearTimeout(idle);
    if (touched || reduce || !visible) return;
    idle = window.setTimeout(() => {
      if (touched || !visible) return;
      const key = s.step === "plan" ? "v" : s.step === "push" ? "a" : s.step === "shipped" ? "r" : "";
      if (key) {
        const cap = hintEl.querySelector<HTMLElement>(`[data-key="${key}"]`);
        cap?.classList.add("down");
        window.setTimeout(() => { cap?.classList.remove("down"); press(key); auto(); }, 180);
      } else auto();
    }, s.step === "shipped" ? 5200 : 6500);
  };
  const take = () => { touched = true; clearTimeout(idle); };

  fig.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const b = t.closest<HTMLElement>("[data-key]");
    const st = t.closest<HTMLElement>("[data-step]");
    if (b || st) take();
    if (b) press(b.dataset.key!);
    else if (st) jump(st.dataset.step as Step);
  });

  // The edge catches a light that follows the pointer, eased so it trails
  // the hand a little instead of snapping to it.
  if (matchMedia("(hover: hover) and (pointer: fine)").matches && !reduce) {
    let tx = 0.5, ty = -0.2, x = tx, y = ty, raf = 0;
    const step = () => {
      x += (tx - x) * 0.14; y += (ty - y) * 0.14;
      root.style.setProperty("--mx", `${(x * 100).toFixed(2)}%`);
      root.style.setProperty("--my", `${(y * 100).toFixed(2)}%`);
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 ? requestAnimationFrame(step) : 0;
    };
    root.addEventListener("pointermove", (e) => {
      const r = root.getBoundingClientRect();
      tx = (e.clientX - r.left) / r.width; ty = (e.clientY - r.top) / r.height;
      if (!raf) raf = requestAnimationFrame(step);
    });
    root.addEventListener("pointerenter", () => root.classList.add("lit"));
    root.addEventListener("pointerleave", () => root.classList.remove("lit"));
  }

  // Real keys, while the demo is on screen.
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; auto(); }, { threshold: 0.35 }).observe(root);
  const KEYMAP: Record<string, string> = { enter: "enter" };
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (!visible || e.metaKey || e.ctrlKey || e.altKey || /INPUT|TEXTAREA|SELECT/.test(t.tagName)) return;
    const key = KEYMAP[e.key.toLowerCase()] ?? e.key.toLowerCase();
    if (key === "enter" && /BUTTON|A/.test(t.tagName)) return;
    if (!["v", "a", "r", "e", "enter", ...Object.keys(NOTES)].includes(key)) return;
    take();
    const cap = fig.querySelector<HTMLElement>(`.hint [data-key="${key}"]`) ?? root.querySelector<HTMLElement>(`[data-key="${key}"]`);
    cap?.classList.add("down");
    window.setTimeout(() => cap?.classList.remove("down"), 140);
    press(key);
  });
</script>

<style is:global>
  @property --gr { syntax: "<length>"; inherits: false; initial-value: 0px; }
</style>

<style>
  .demo { margin: 0; display: grid; gap: 1.6rem; justify-items: center; }
  .stage { width: 100%; perspective: 2200px; position: relative; }
  /* One light behind the product, breathing slowly. */
  .stage::before {
    content: ""; position: absolute; inset: -18% -4% 4%; z-index: -1; pointer-events: none;
    background:
      radial-gradient(38% 46% at 50% 34%, rgba(189, 147, 249, 0.42), transparent 70%),
      radial-gradient(60% 60% at 50% 45%, rgba(120, 90, 220, 0.2), transparent 72%);
    animation: breathe 9s ease-in-out 1.6s infinite;
  }
  @keyframes breathe { 50% { opacity: 0.72; transform: scale(1.04); } }
  /* The window rests on its own light. */
  .stage::after {
    content: ""; position: absolute; left: 8%; right: 8%; bottom: -5%; height: 16%; z-index: -1; pointer-events: none;
    background: radial-gradient(50% 50% at 50% 50%, rgba(189, 147, 249, 0.3), transparent 72%);
  }
  .window {
    position: relative; border-radius: 14px; color: #e6e6ef;
    border: 1px solid transparent;
    box-shadow: var(--lift);
    font: 400 clamp(10.5px, 1.05vw, 13.5px)/1.62 var(--mono);
    transform-origin: 50% 0%;
    animation: settle 1100ms var(--ease-out) 380ms both;
  }
  @keyframes settle {
    from { transform: rotateX(14deg) translateY(28px) scale(0.97); opacity: 0; }
    to { transform: rotateX(5deg); opacity: 1; }
  }
  /* The tilt flattens as you scroll toward it, where supported. */
  @supports (animation-timeline: view()) {
    .stage { animation: flatten linear both; animation-timeline: view(); animation-range: entry 40% cover 45%; }
    @keyframes flatten { to { transform: rotateX(-5deg); } }
  }
  /* The edge catches a light that follows the pointer: a third layer of the
     border itself, whose radius grows in on hover. */
  .window {
    background:
      linear-gradient(var(--term), var(--term)) padding-box,
      radial-gradient(var(--gr) circle at var(--mx, 50%) var(--my, 0%), rgba(225, 210, 255, 0.85), transparent) border-box,
      var(--edge) border-box;
    transition: --gr 500ms var(--ease-out);
  }
  .window.lit { --gr: 380px; }
  .window::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: radial-gradient(calc(var(--gr) * 1.6) circle at var(--mx, 50%) var(--my, 0%), rgba(189, 147, 249, 0.07), transparent);
  }
  .chrome { display: flex; align-items: center; gap: 8px; padding: 12px 14px 4px; color: var(--t-dim); font-size: 0.85em; }
  .chrome i { width: 11px; height: 11px; border-radius: 50%; background: #3a3c48; }
  .chrome span { margin-left: auto; margin-right: auto; transform: translateX(-30px); }
  .screen { padding: 8px 18px 14px; display: grid; gap: 10px; }
  .head { margin-bottom: 2px; }
  /* Connection dots glow softly, out of step, like the real ones polling. */
  .live { display: inline-block; animation: glow 3.2s ease-in-out var(--d, 0s) infinite; }
  @keyframes glow { 50% { opacity: 0.45; } }
  .panes { display: grid; grid-template-columns: minmax(0, 1fr); min-height: 30.5em; }
  @media (min-width: 820px) { .panes { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); } }
  .pane { min-width: 0; }
  .list { display: none; padding-right: 16px; border-right: 2px solid var(--lavender); }
  @media (min-width: 820px) { .list { display: block; } .detail { padding-left: 18px; } }
  .foot { display: flex; justify-content: space-between; gap: 1rem; white-space: nowrap; overflow: hidden; border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 8px; }
  .keys { color: var(--t-muted); overflow: hidden; text-overflow: ellipsis; }
  .keys.note { color: var(--lavender-2); }

  .screen :global(.row) { display: flex; justify-content: space-between; gap: 1rem; white-space: nowrap; min-width: 0; }
  .screen :global(.row > span) { overflow: hidden; text-overflow: ellipsis; }
  .screen :global(.l) { white-space: pre; overflow: hidden; text-overflow: ellipsis; min-height: 1.62em; border-radius: 3px; }
  .screen :global(.l.sel) { background: #2c2e3c; border-radius: 0; }
  .screen :global(.sec) { display: flex; align-items: center; gap: 1ch; white-space: pre; overflow: hidden; margin-top: 2px; min-height: 1.62em; }
  .screen :global(.sec::after) { content: ""; flex: 1; border-top: 1px solid var(--t-line); }
  .screen :global(.t-acc) { color: var(--lavender); }
  .screen :global(.t-warn) { color: var(--amber); }
  .screen :global(.t-good) { color: var(--green); }
  .screen :global(.t-mut) { color: var(--t-muted); }
  .screen :global(.t-dim) { color: var(--t-dim); }
  .screen :global(.t-b) { font-weight: 600; color: #f4f4fa; }
  /* The in-progress glyph turns, the way cairn's own spinner does. */
  .screen :global(.spin::before) { content: "◐"; animation: spin 1.2s linear infinite; }
  @keyframes spin { 0% { content: "◐"; } 25% { content: "◓"; } 50% { content: "◑"; } 75% { content: "◒"; } }
  .screen :global(.card) { border: 1.5px solid var(--t-line); border-radius: 6px; padding: 4px 10px 6px; margin: 8px 0 10px; display: grid; gap: 4px; }
  .screen :global(.card.warn) { border-color: var(--amber); animation: await 2.6s ease-in-out infinite; }
  .screen :global(.card.good) { border-color: var(--green); }
  @keyframes await { 50% { box-shadow: 0 0 0 3px rgba(255, 184, 108, 0.12); } }
  .screen :global(.k) {
    background: var(--t-line); color: #e6e6ef; border: 0; padding: 0 7px; margin-right: 5px; font: inherit; cursor: pointer;
    transition: transform 140ms var(--ease-out), background-color 160ms ease;
  }
  .screen :global(.k b) { color: var(--lavender); font-weight: 400; }
  .screen :global(.k.p) { background: var(--lavender); color: #15161d; }
  .screen :global(.k.p b) { color: #15161d; }
  .screen :global(.k:active), .screen :global(.k.down) { transform: scale(0.94); }
  @media (hover: hover) and (pointer: fine) {
    .screen :global(.k:hover) { background: #4a4d63; }
    .screen :global(.k.p:hover) { background: var(--lavender-2); }
  }

  .hint { color: var(--fg-2); font-size: 0.95rem; min-height: 2.75rem; display: grid; place-items: center; text-align: center; }
  .hint :global(.hint-in) { display: inline-flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; justify-content: center; }
  .hint :global(.hk) { display: inline-flex; align-items: center; gap: 0.7rem; white-space: nowrap; }
  .hint :global(.kbd.big) {
    font-size: 1.15rem; min-width: 2.6rem; height: 2.6rem; border: 0; cursor: pointer; border-radius: 0.6rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), inset 0 -3px 0 rgba(0, 0, 0, 0.4), 0 2px 0 #0a0b0e, 0 6px 16px rgba(189, 147, 249, 0.18);
    color: var(--lavender-2);
    transition: transform 120ms var(--ease-out), box-shadow 120ms var(--ease-out);
    animation: invite 2.4s ease-in-out 1.8s infinite;
  }
  .hint :global(.kbd.big:active), .hint :global(.kbd.big.down) {
    transform: translateY(2px); animation: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 -1px 0 rgba(0, 0, 0, 0.4), 0 0 0 #0a0b0e, 0 2px 8px rgba(189, 147, 249, 0.2);
  }
  @keyframes invite { 0%, 70%, 100% { transform: none; } 80% { transform: translateY(2px); } 90% { transform: none; } }

  /* The step rail: where the ticket is, and a way to jump anywhere. */
  .rail {
    --n: 5; list-style: none; margin: 0.4rem 0 0; padding: 0; position: relative; width: min(100%, 40rem);
    display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr));
  }
  .rail::before, .rail::after {
    content: ""; position: absolute; top: 0.45rem; left: 10%; right: 10%; height: 1px; background: var(--line-2); transform-origin: left;
  }
  .rail::after { background: linear-gradient(90deg, var(--green), var(--lavender)); transform: scaleX(var(--p)); transition: transform 700ms var(--ease-out); }
  .rail li { display: grid; justify-items: center; }
  .rail button {
    position: relative; z-index: 1; display: grid; justify-items: center; gap: 0.55rem; padding: 0 0.25rem 0.25rem; border: 0; background: none; cursor: pointer;
    font: 500 0.8rem/1 var(--mono); color: var(--fg-3); transition: color 200ms ease;
  }
  .rail i {
    width: 0.9rem; height: 0.9rem; border-radius: 50%; background: var(--bg); box-shadow: inset 0 0 0 1px var(--line-3);
    transition: box-shadow 300ms ease, background-color 300ms ease, transform 300ms var(--ease-out);
  }
  .rail .done { color: var(--fg-2); }
  .rail .done i { background: var(--green); box-shadow: 0 0 0 3px rgba(80, 250, 123, 0.12); }
  .rail [aria-current] { color: var(--fg); }
  .rail [aria-current] i { background: var(--lavender); box-shadow: 0 0 0 4px rgba(189, 147, 249, 0.18), 0 0 18px rgba(189, 147, 249, 0.6); transform: scale(1.1); }
  .rail [aria-current].done i { background: var(--green); box-shadow: 0 0 0 4px rgba(80, 250, 123, 0.16), 0 0 18px rgba(80, 250, 123, 0.5); }
  .rail button:active i { transform: scale(0.85); }
  @media (hover: hover) and (pointer: fine) { .rail button:hover { color: var(--fg); } }
</style>
