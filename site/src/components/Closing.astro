---
import { Image } from "astro:assets";
import photo from "../assets/cairn-emparis.jpg";
import CopyCommand from "./CopyCommand.astro";
import Icon from "./Icon.astro";
---
<section class="closing" aria-labelledby="closing-title">
  <figure class="photo">
    <Image src={photo} alt="A cairn of flat stones on the Plateau d'Emparis, facing the glaciers of La Meije at dusk" widths={[900, 1600, 2400]} sizes="100vw" loading="lazy" decoding="async" />
  </figure>
  <div class="wrap inner">
    <h2 class="h2" id="closing-title">Mark the trail.</h2>
    <p class="lede">Hikers stack a few stones so the next person knows where the path goes. cairn does that for every ticket your agents walk: where it is, what it waits for, who decides.</p>
    <div class="cta">
      <CopyCommand id="cmd-close" command="git clone https://github.com/Gradrien/cairn && cairn/install.sh --herdr" />
      <a class="btn btn-ghost" href="https://github.com/Gradrien/cairn"><Icon name="github" />Star on GitHub</a>
    </div>
  </div>
  <p class="credit wrap">Photo: Plateau d'Emparis, Hautes-Alpes, by Dominicus Johannes Bergsma, <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>, colour-graded for this page (<a href="https://commons.wikimedia.org/wiki/File:Plateau_d%27emparis,_(2250_m.)_cairn.JPG">source</a>).</p>
</section>

<style>
  .closing { position: relative; isolation: isolate; padding-block: clamp(8rem, 18vw, 14rem) 2rem; overflow: hidden; }
  .closing::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 1px; z-index: 1; background: linear-gradient(90deg, transparent, var(--line-2) 20%, var(--line-2) 80%, transparent); }
  .photo { position: absolute; inset: 0; z-index: -1; margin: 0; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 30% 40%; }
  /* The photo dissolves into the page on every side the text needs. */
  .photo::after {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, var(--bg) 0%, rgba(8, 9, 12, 0) 16%, rgba(8, 9, 12, 0) 72%, var(--bg) 100%),
      linear-gradient(90deg, rgba(8, 9, 12, 0) 38%, rgba(8, 9, 12, 0.72) 68%);
  }
  @media (max-width: 899px) { .photo::after { background: linear-gradient(180deg, var(--bg) 0%, rgba(8, 9, 12, 0.35) 30%, rgba(8, 9, 12, 0.85) 75%, var(--bg) 100%); } }
  /* The photo drifts a little slower than the page: depth, not a show. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .photo :global(img) { animation: drift linear both; animation-timeline: view(); scale: 1.08; }
      @keyframes drift { from { transform: translateY(-4%); } to { transform: translateY(4%); } }
    }
  }
  .inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  .cta :global(.btn) { flex: none; }
  @media (min-width: 900px) { .inner { padding-left: calc(var(--gutter) + 50%); } }
  .h2 { font-size: clamp(2.75rem, 6vw, 5rem); }
  .lede { color: #c3c7d2; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; width: 100%; margin-top: 0.5rem; }
  .cta :global(.copycmd) { flex: 1 1 22rem; }
  .credit { margin-top: clamp(5rem, 10vw, 8rem); font-size: 0.78rem; color: var(--fg-3); }
  .credit a { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-color: var(--line-3); }
</style>
