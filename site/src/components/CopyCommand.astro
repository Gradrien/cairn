---
import Icon from "./Icon.astro";
interface Props { command: string; id: string; size?: "lg" | "md" }
const { command, id, size = "lg" } = Astro.props;
// Words never break; only a URL may, and only after a slash.
const words = command.split(" ");
---
<div class:list={["copycmd", size]}>
  <code id={id}><span class="pr" aria-hidden="true">$</span>{words.map((w, i) => (
    <>{i > 0 && " "}<span class="w">{w.includes("://") ? w.split("/").map((part, j) => <>{j > 0 && "/"}{j > 2 && <wbr />}{part}</>) : w}</span></>
  ))}</code>
  <button type="button" class="copybtn" data-copy={id} aria-label="Copy the command">
    <span class="ico ico-copy"><Icon name="copy" /></span>
    <span class="ico ico-ok"><Icon name="check" /></span>
  </button>
</div>

<script>
  document.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
    if (!b) return;
    const el = document.getElementById(b.dataset.copy!)!;
    const text = (el.textContent || "").replace(/^\$/, "").trim();
    const ok = () => {
      b.classList.add("copied");
      b.setAttribute("aria-label", "Copied");
      window.setTimeout(() => { b.classList.remove("copied"); b.setAttribute("aria-label", "Copy the command"); }, 1600);
    };
    const select = () => { const r = document.createRange(); r.selectNodeContents(el); const s = getSelection()!; s.removeAllRanges(); s.addRange(r); };
    navigator.clipboard?.writeText(text).then(ok, select) ?? select();
  });
</script>

<style>
  .copycmd {
    display: flex; align-items: flex-start; min-width: 0; max-width: 100%; border-radius: 0.8rem;
    border: 1px solid transparent;
    background: linear-gradient(180deg, #17191f, #111318) padding-box, var(--edge) border-box;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 12px 32px -12px rgba(0, 0, 0, 0.7);
    transition: box-shadow 240ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .copycmd:hover { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 0 0 4px rgba(189, 147, 249, 0.07), 0 12px 32px -12px rgba(0, 0, 0, 0.7); }
  }
  .copycmd.lg { min-height: 3rem; }
  .copycmd.md { min-height: 2.75rem; font-size: 0.92rem; }
  /* Commands wrap at their spaces rather than being cut: what you copy is what you read. */
  code { flex: 1; min-width: 0; padding: 0.7rem 0.25rem 0.7rem 2.05rem; text-indent: -1.05rem; white-space: normal; line-height: 1.5; font-size: 0.9em; color: var(--fg); }

  .w { white-space: nowrap; }
  .pr { color: var(--fg-3); margin-right: 0.6em; user-select: none; }
  @media (max-width: 480px) { code { font-size: 0.82em; } }
  .copybtn { margin-top: 0.25rem; }
  .copybtn {
    position: relative; flex: none; width: 2.5rem; height: 2.5rem; margin: 0 0.25rem; border: 0; border-radius: 0.6rem;
    background: transparent; color: var(--fg-2); cursor: pointer; display: grid; place-items: center;
    transition: transform 140ms var(--ease-out), background-color 160ms ease, color 160ms ease;
  }
  .copybtn:active { transform: scale(0.94); }
  @media (hover: hover) and (pointer: fine) { .copybtn:hover { background: rgba(255, 255, 255, 0.06); color: var(--fg); } }
  .ico { position: absolute; display: grid; transition: opacity 180ms ease, transform 220ms var(--ease-out), filter 180ms ease; }
  .ico :global(svg) { width: 1.1rem; height: 1.1rem; }
  .ico-ok { opacity: 0; transform: scale(0.8); filter: blur(2px); color: var(--green); }
  .copied .ico-copy { opacity: 0; transform: scale(0.8); filter: blur(2px); }
  .copied .ico-ok { opacity: 1; transform: none; filter: none; }
</style>
