---
// Before / after: what herdr shows you (five panes to open), and what cairn
// shows you (one list, the decisions first). Example data.
const panes = [
  { who: "claude · eng-412", st: "idle", line: "I wrote the plan in ~/.cairn/chantiers/ENG-412.md. Let me know if…" },
  { who: "claude · eido-7", st: "blocked", line: "Before I continue: should the invoice PDF include the VAT…" },
  { who: "claude · eng-398", st: "working", line: "Running go test ./webhooks/... (attempt 3)" },
  { who: "codex · eido-5", st: "idle", line: "Pushed 2 commits. CI is running on #31." },
  { who: "claude · eng-377", st: "done", line: "Done. The PR was merged into main." },
];
---
<section class="section rule" id="why">
  <div class="wrap grid">
    <div class="copy">
      <h2 class="h2"><span class="blk">Five agents. Five panes.</span> <span class="blk dim">One list.</span></h2>
      <p class="body">herdr tells you an agent is idle. Not whether it finished, is waiting on your approval, or is stuck on a question. <strong>cairn reads every ticket's state and puts the answer on one screen</strong>, with the ones that need you first and the exact thing to decide.</p>
      <p class="body">Each ticket becomes a <em>chantier</em>, French for a work site: the ticket, its git worktree, its herdr workspace, its agents, its plan and its pull request, moving from Plan to Build, Review and Shipped.</p>
    </div>

    <div class="viz" aria-label="Five agent panes on the left; the same work as one list in cairn on the right">
      <div class="mosaic" aria-hidden="true">
        {panes.map((p) => (
          <div class={`pane st-${p.st}`}>
            <div class="ph"><span class="dot"></span>{p.who}<span class="st">{p.st}</span></div>
            <div class="pl">{p.line}</div>
          </div>
        ))}
      </div>
      <div class="arrow" aria-hidden="true">
        <svg viewBox="0 0 40 12"><path d="M0 6h36m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="cairn">
        <div class="ch"><span class="lv">cairn</span><span class="mu">5 tickets · 2 waiting for you</span></div>
        <div class="grp warn" style="--n:0">Waiting for you</div>
        <div class="it" style="--n:1"><b>ENG-412</b> Rate-limit the public API<span class="why warn">Approve the plan · 12 min</span></div>
        <div class="it" style="--n:2"><b>EIDO-7</b> Export invoices as PDF<span class="why warn">Answer 1 question · 3 min</span></div>
        <div class="grp" style="--n:3">In progress</div>
        <div class="it" style="--n:4"><b>ENG-398</b> Retry failed webhooks<span class="why"><span class="lv">Build</span> 4/6</span></div>
        <div class="it" style="--n:5"><b>EIDO-5</b> Dark mode for the editor<span class="why"><span class="lv">Review</span> · CI <span class="ok">✓</span></span></div>
        <div class="grp" style="--n:6">Shipped</div>
        <div class="it done" style="--n:7"><b>ENG-377</b> Paginate the audit log<span class="why">cleaned up</span></div>
        <div class="ex">example data</div>
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: clamp(3rem, 6vw, 5rem); }
  .copy { display: grid; gap: 1.5rem; max-width: 46rem; }
  .dim { color: var(--fg-3); }
  .viz { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; align-items: center; }
  @media (min-width: 980px) { .viz { grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1.05fr); gap: 1.5rem; } }

  .mosaic { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; padding: 6px; border-radius: 12px; border: 1px solid transparent; background: linear-gradient(#0b0c10, #0b0c10) padding-box, var(--edge) border-box; }
  .pane { background: #111218; border-radius: 6px; padding: 0.7rem 0.8rem; min-height: 6.4rem; display: grid; align-content: start; gap: 0.5rem; font: 400 0.76rem/1.5 var(--mono); }
  .pane:first-child { grid-column: span 2; }
  .ph { display: flex; align-items: center; gap: 0.5rem; color: var(--fg-2); }
  .st { margin-left: auto; color: var(--fg-3); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #5a5d6b; flex: none; }
  .st-working .dot { background: var(--amber); }
  .st-blocked .dot { background: var(--red); }
  .st-done .dot { background: var(--green); }
  .pl { color: var(--fg-3); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .arrow { color: var(--fg-3); justify-self: center; width: 2.5rem; }
  @media (max-width: 979px) { .arrow { transform: rotate(90deg); } }

  .cairn { border-radius: 12px; padding: 1rem 1.15rem 1.15rem; font: 400 0.84rem/1.6 var(--mono); border: 1px solid transparent; background: linear-gradient(var(--term), var(--term)) padding-box, var(--edge) border-box; box-shadow: var(--lift); }
  .ch { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.6rem; flex-wrap: wrap; }
  .lv { color: var(--lavender); }
  .mu { color: var(--t-muted); }
  .grp { color: var(--t-muted); margin-top: 0.5rem; }
  .grp.warn { color: var(--amber); }
  .it { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 0.7rem; padding: 0.15rem 0 0.15rem 1rem; color: #e6e6ef; }
  .it b { font-weight: 600; }
  .why { grid-column: 2; color: var(--t-muted); }
  .why.warn { color: var(--amber); }
  .ok { color: var(--green); }
  .done { opacity: 0.55; }
  .blk { display: block; }
  .copy em { font-style: italic; color: var(--fg); }
  .ex { margin-top: 0.8rem; text-align: right; color: var(--t-dim); font-size: 0.75rem; }

  /* As the section scrolls in, the panes quiet down and the list assembles
     row by row, the decisions first. Static where view timelines are missing. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .viz { view-timeline: --viz block; }
      .cairn .grp, .cairn .it {
        animation: slot linear both; animation-timeline: --viz;
        animation-range: entry calc(30% + var(--n) * 7%) entry calc(62% + var(--n) * 7%);
      }
      .pane { animation: quiet linear both; animation-timeline: --viz; animation-range: entry 40% cover 50%; }
      @keyframes slot { from { opacity: 0; transform: translateX(-28px); filter: blur(4px); } }
      @keyframes quiet { to { opacity: 0.45; } }
    }
  }
</style>
