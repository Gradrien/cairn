---
// cairn's real keys, grouped by the moment you reach for them.
const groups: Array<{ name: string; line: string; keys: Array<[string, string]> }> = [
  { name: "Decide", line: "The three moments that are yours.", keys: [["v", "Approve"], ["e", "Answer"], ["a", "Allow push"]] },
  { name: "Move", line: "Get to the right place fast.", keys: [["↵", "Go to agent"], ["t", "Board"], ["ctrl k", "Palette"]] },
  { name: "Act", line: "Everything else a ticket needs.", keys: [["p", "Plan"], ["n", "New ticket"], ["c", "Comments"], ["f", "Fix CI"], ["d", "Diff"], ["s", "Settings"]] },
];
---
<section class="section rule" id="keys">
  <div class="wrap">
    <div class="head" data-reveal-group>
      <h2 class="h2"><span class="blk">One command to remember.</span> <span class="blk dim">Everything else is a key.</span></h2>
      <p class="body">Type <code>cairn</code> once, or press <span class="kbd">prefix</span> <span class="kbd">a</span> in herdr. Every key is also a button, and everything works with the mouse.</p>
    </div>
    <div class="groups">
      {groups.map((g) => (
        <div class="group" data-reveal>
          <div class="gh">
            <h3 class="h3">{g.name}</h3>
            <p>{g.line}</p>
          </div>
          <ul class="caps">
            {g.keys.map(([k, label], i) => (
              <li style={`--k:${i}`}>
                <span class="keys">{k.split(" ").map((p) => <span class:list={["cap", { wide: p.length > 1 }]}>{p}</span>)}</span>
                <span class="label">{label}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: grid; gap: 1.25rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .blk { display: block; }
  .dim { color: var(--fg-3); }
  .body code { font-size: 0.92em; color: var(--fg); }
  .groups { display: grid; gap: 0; }
  .group { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; padding-block: 2rem; border-top: 1px solid var(--line); }
  @media (min-width: 860px) { .group { grid-template-columns: 15rem minmax(0, 1fr); gap: 3rem; align-items: center; } }
  .gh { display: grid; gap: 0.3rem; }
  .gh p { margin: 0; color: var(--fg-3); font-size: 0.93rem; }
  .caps { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1.25rem 1.75rem; }
  .caps li { display: grid; justify-items: start; gap: 0.6rem; }
  .keys { display: flex; gap: 0.35rem; }
  .cap {
    display: grid; place-items: center; min-width: 3.4rem; height: 3.4rem; padding: 0 0.8rem; border-radius: 0.7rem;
    font: 500 1.2rem/1 var(--mono); color: var(--lavender-2);
    background: linear-gradient(180deg, #2c2f39 0%, #20222a 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), inset 0 -4px 0 rgba(0, 0, 0, 0.38), 0 2px 0 #0a0b0e, 0 8px 18px rgba(0, 0, 0, 0.45);
    transition: transform 120ms var(--ease-out), box-shadow 120ms var(--ease-out);
  }
  .cap.wide { font-size: 0.95rem; }
  /* As a group arrives, its keys are pressed once, left to right. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .group.in .cap { animation: press 420ms var(--ease-out) both; animation-delay: calc(500ms + var(--k) * 110ms); }
    @keyframes press {
      40% { transform: translateY(3px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 -1px 0 rgba(0, 0, 0, 0.38), 0 0 0 #0a0b0e, 0 2px 6px rgba(0, 0, 0, 0.45), 0 0 16px rgba(189, 147, 249, 0.35); color: #fff; }
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .caps li:hover .cap { transform: translateY(2px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 -2px 0 rgba(0, 0, 0, 0.38), 0 0 0 #0a0b0e, 0 3px 8px rgba(0, 0, 0, 0.45); }
  }
  .label { font-size: 0.9rem; color: var(--fg-2); }
</style>
